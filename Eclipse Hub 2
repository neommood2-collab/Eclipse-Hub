local function criarToggle(parent, y, texto, corAtiva, callback)
    local btn = criar("TextButton", {
        Size = UDim2.new(1,-8,0,36), Position = UDim2.new(0,4,0,y),
        BackgroundColor3 = Color3.fromRGB(40,44,54), Text = texto .. ": OFF",
        Font = Enum.Font.GothamBold, TextSize = 12,
        TextColor3 = Color3.fromRGB(200,205,215), AutoButtonColor = false,
    }, parent)
    arredondar(btn, 8)
    stroke(btn, Color3.fromRGB(55,60,75), 1)
    local ativo = false
    btn.MouseButton1Click:Connect(function()
        ativo = not ativo
        btn.Text = texto .. ": " .. (ativo and "ON" or "OFF")
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = ativo and corAtiva or Color3.fromRGB(40,44,54)
        }):Play()
        btn.TextColor3 = ativo and Color3.new(1,1,1) or Color3.fromRGB(200,205,215)
        if callback then callback(ativo) end
    end)
    return btn
end

-- FUNÇÕES
local function toggleESP(on) estado.espGeral = on end
local function toggleFullbright(on)
    if on then
        Lighting.Brightness = 5
        Lighting.ClockTime = 12
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
    else
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = true
    end
end
local function toggleNoFog(on)
    Lighting.FogStart = on and 100000 or 0
    Lighting.FogEnd = 100000
end
local function toggleSpeed(on)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = on and 50 or 16 end
end
local function toggleJump(on)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.JumpPower = on and 120 or 50 end
end
local function toggleAutoGrab(on) estado.autoGrab = on end
local function toggleNoclip(on)
    estado.noclipAtivo = on
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = not on end
        end
    end
end

local function setGhost(on)
    estado.ghost = on
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if on then
        if not root then return end
        estado.ghostPosOriginal = root.CFrame
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if hum then hum.PlatformStand = true end
        Camera.CameraType = Enum.CameraType.Scriptable
    else
        if root and estado.ghostPosOriginal then
            root.CFrame = estado.ghostPosOriginal
        end
        if hum then hum.PlatformStand = false end
        Camera.CameraType = Enum.CameraType.Custom
        if hum then Camera.CameraSubject = hum end
        estado.ghostPosOriginal = nil
    end
end

RunService.RenderStepped:Connect(function()
    if estado.ghost then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local moveDir = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Vector3.new(0,0,-1) end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir + Vector3.new(0,0,1) end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir + Vector3.new(-1,0,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Vector3.new(1,0,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir + Vector3.new(0,-1,0) end
        if moveDir.Magnitude > 0 then
            local dir = Camera.CFrame:VectorToWorldSpace(moveDir.Unit)
            root.CFrame = root.CFrame + dir * 60 * task.wait()
        end
    end
end)

