RunService.RenderStepped:Connect(function()
    if estado.espAtivado or estado.espGeral then atualizarESP() end
    if not (estado.espAtivado or estado.espGeral) and next(highlights) then limparESP() end
    if estado.aimLock and estado.aimAlvo then
        local alvo = acharAlvo(estado.aimAlvo)
        if alvo then
            local posCam = Camera.CFrame.Position
            local dirAlvo = (alvo.Position - posCam).Unit
            local cfAlvo = CFrame.lookAt(posCam, posCam + dirAlvo)
            Camera.CFrame = Camera.CFrame:Lerp(cfAlvo, 0.4)
        end
    end
end)

