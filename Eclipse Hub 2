local function getRole(player)
    local containers = {player:FindFirstChild("Backpack"), player.Character}
    local function hasItem(name)
        for _, c in pairs(containers) do
            if c and c:FindFirstChild(name) then return true end
        end
        return false
    end
    if hasItem(ITEM_MURDERER) then return "Murderer" end
    if hasItem(ITEM_SHERIFF)  then return "Sheriff"  end
    return "Innocent"
end

local function criar(cls, props, parent)
    local o = Instance.new(cls)
    for k,v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
