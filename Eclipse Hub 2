-- ESP
local highlights = {}
local function limparESP()
    for _, h in pairs(highlights) do
        if h and h.Parent then h:Destroy() end
    end
    highlights = {}
end
local function corDoCargo(role)
    if estado.modoZumbi then
        if role == "Murderer" then return Color3.fromRGB(120, 200, 80)
        elseif role == "Sheriff" then return Color3.fromRGB(0, 120, 255)
        else return Color3.fromRGB(200, 200, 200) end
    else
        if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
        elseif role == "Sheriff" then return Color3.fromRGB(0, 120, 255)
        else return Color3.fromRGB(0, 255, 80) end
    end
end
local function atualizarESP()
    if not (estado.espAtivado or estado.espGeral) then
        if next(highlights) then limparESP() end
        return
    end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local role = getRole(player)
            local cor = corDoCargo(role)
            local h = highlights[player]
            if not h or not h.Parent or h.Adornee ~= char then
                if h and h.Parent then h:Destroy() end
                h = Instance.new("Highlight")
                h.Name = "EclipseESP"
                h.Adornee = char
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillTransparency = 0.4
                h.OutlineTransparency = 0
                h.FillColor = cor
                h.OutlineColor = cor
                h.Parent = char
                highlights[player] = h
            else
                h.FillColor = cor
                h.OutlineColor = cor
            end
            h.Enabled = true
        end
    end
    for player, h in pairs(highlights) do
        if not player.Parent or not player.Character then
            if h and h.Parent then h:Destroy() end
            highlights[player] = nil
        end
    end
end

-- AUTO GRAB
local grabEmAndamento = false
local xerifesMonitorados = {}
local posMorteXerife = nil

local function parteDaGun(item)
    if item:IsA("Tool") then return item:FindFirstChild("Handle")
    elseif item:IsA("Model") then return item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
    elseif item:IsA("BasePart") then return item end
    return nil
end

local function tentarGrab()
    if not estado.autoGrab or grabEmAndamento then return end
    if not posMorteXerife then return end
    local meuChar = LocalPlayer.Character
    local meuRoot = meuChar and meuChar:FindFirstChild("HumanoidRootPart")
    if not meuRoot then return end
    local jaTenho = (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild(ITEM_SHERIFF))
        or (meuChar and meuChar:FindFirstChild(ITEM_SHERIFF))
    if jaTenho then return end
    local gunEncontrada = nil
    local menorDist = RAIO_GRAB
    for _, item in pairs(workspace:GetDescendants()) do
        if item.Name == ITEM_SHERIFF then
            local parte = parteDaGun(item)
            if parte then
                local dist = (parte.Position - posMorteXerife).Magnitude
                if dist < menorDist then
                    menorDist = dist
                    gunEncontrada = item
                end
            end
        end
    end
    if not gunEncontrada then return end
    grabEmAndamento = true
    local posOriginal = meuRoot.CFrame
    local parte = parteDaGun(gunEncontrada)
    meuRoot.CFrame = parte.CFrame + Vector3.new(0, 3, 0)
    task.spawn(function()
        local tempoMax, tempo, pegou = 2, 0, false
        while tempo < tempoMax and not pegou do
            task.wait(0.1)
            tempo = tempo + 0.1
            parte.CFrame = meuRoot.CFrame
            task.wait(0.05)
            local cd = gunEncontrada:FindFirstChildWhichIsA("ClickDetector", true)
            if cd then fireclickdetector(cd) end
            local pp = gunEncontrada:FindFirstChildWhichIsA("ProximityPrompt", true)
            if pp then fireproximityprompt(pp) end
            if gunEncontrada:IsA("Tool") then
                pcall(function() gunEncontrada.Parent = LocalPlayer.Backpack end)
            end
            local tem = (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild(ITEM_SHERIFF))
                or (meuChar and meuChar:FindFirstChild(ITEM_SHERIFF))
            if tem then pegou = true break end
        end
        task.wait(0.1)
        if meuRoot and meuRoot.Parent then
            meuRoot.CFrame = posOriginal
        end
        grabEmAndamento = false
    end)
end

local function monitorarXerife(player)
    if xerifesMonitorados[player] then return end
    xerifesMonitorados[player] = true
    local function conectarPersonagem(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        hum.Died:Connect(function()
            if getRole(player) ~= "Sheriff" then return end
            local corpo = char:FindFirstChild("HumanoidRootPart")
            if corpo then
                posMorteXerife = corpo.Position
            else
                posMorteXerife = char:GetPivot().Position
            end
            task.wait(3)
            if estado.autoGrab then tentarGrab() end
            task.wait(10)
            posMorteXerife = nil
        end)
    end
    if player.Character then conectarPersonagem(player.Character) end
    player.CharacterAdded:Connect(conectarPersonagem)
end

task.spawn(function()
    while true do
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and getRole(player) == "Sheriff" then
                monitorarXerife(player)
            end
        end
        task.wait(1)
    end
end)

