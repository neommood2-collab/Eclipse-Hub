local function visibleToCamera(character,part)
    if not character or not part then return false end

    camera = workspace.CurrentCamera
    if not camera then return false end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character}

    local origin = camera.CFrame.Position
    local direction = part.Position-origin
    local result = workspace:Raycast(origin,direction,params)

    return result == nil or result.Instance:IsDescendantOf(character)
end

--========================================================
-- VALIDAÇÃO SEPARADA: ESP E AIMLOCK
--========================================================

local function validESPPlayer(p)
    if p == player or not p.Character then return false end

    local char = p.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if not hum or hum.Health <= 0 or not root then
        return false
    end

    local myRoot = player.Character
        and player.Character:FindFirstChild("HumanoidRootPart")

    if not myRoot then return false end

    return (myRoot.Position-root.Position).Magnitude
        <= settings.MaxDistance
end

local function validAimPlayer(p)
    if not validESPPlayer(p) then return false end

    if settings.TeamCheck and p.Team == player.Team then
        return false
    end

    if settings.WallCheck then
        local head = p.Character:FindFirstChild("Head")

        if not head or not visibleToCamera(p.Character,head) then
            return false
        end
    end

    return true
end

--========================================================
-- JOGADOR MAIS PRÓXIMO FISICAMENTE
-- NÃO USA FOV E NÃO EXIGE ESTAR NA TELA
--========================================================

local function getClosestPlayer()
    local myRoot = player.Character
        and player.Character:FindFirstChild("HumanoidRootPart")

    if not myRoot then return nil end

    local closest = nil
    local shortestDistance = math.huge

    for _,p in ipairs(Players:GetPlayers()) do
        if validAimPlayer(p) then
            local targetRoot =
                p.Character:FindFirstChild("HumanoidRootPart")

            if targetRoot then
                local distance =
                    (myRoot.Position-targetRoot.Position).Magnitude

                if distance < shortestDistance then
                    shortestDistance = distance
                    closest = p
                end
            end
        end
    end

    return closest
end

