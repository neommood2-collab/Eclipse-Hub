--========================================================

local function Create(className, properties, parent)
    local object = Instance.new(className)

    for property, value in pairs(properties) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function Round(object, radius)
    Create("UICorner", {
        CornerRadius = UDim.new(0, radius)
    }, object)
end

local function Outline(object, color, thickness)
    Create("UIStroke", {
        Color = color or Color3.fromRGB(0,130,255),
        Thickness = thickness or 1
    }, object)
end

local function Label(parent, text, height, color, size)
    return Create("TextLabel", {
        Size = UDim2.new(1,-10,0,height or 30),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or Color3.new(1,1,1),
        Font = Enum.Font.GothamBold,
        TextSize = size or 13,
        TextWrapped = true
    }, parent)
end

local function Button(parent, text, callback)
    local button = Create("TextButton", {
        Size = UDim2.new(1,-10,0,36),
        BackgroundColor3 = Color3.fromRGB(38,45,62),
        TextColor3 = Color3.fromRGB(245,247,255),
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        AutoButtonColor = true
    }, parent)

    Round(button,7)

    button.MouseButton1Click:Connect(callback)
    return button
end

local function UpdateButton(button, name, enabled)
    button.Text = name .. (enabled and ": ON" or ": OFF")
    button.BackgroundColor3 = enabled
        and Color3.fromRGB(20,95,75)
        or Color3.fromRGB(38,45,62)
end

