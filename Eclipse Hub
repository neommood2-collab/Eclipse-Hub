AimConnection = RunService.RenderStepped:Connect(function()
    FOV.Visible = FOVEnabled
    FOV.Size = UDim2.fromOffset(FOVSize,FOVSize)
    FOVStroke.Color = FOVColor

    Crosshair.Visible = CrosshairEnabled

    if AimEnabled then
        local target = GetClosestPlayer()
        local camera = workspace.CurrentCamera

        if target and camera then
            local current = camera.CFrame
            local desired = CFrame.lookAt(
                current.Position,
                target.Position
            )

            camera.CFrame = current:Lerp(
                desired,
                math.clamp(AimSmoothness,0,1)
            )
        end
    end
end)

