local function closestPlayerHead()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then return nil end

    local closestHead = nil
    local shortestDistance = math.huge

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local otherCharacter = otherPlayer.Character
            local humanoid = otherCharacter
                and otherCharacter:FindFirstChildOfClass("Humanoid")
            local otherRoot = otherCharacter
                and otherCharacter:FindFirstChild("HumanoidRootPart")
            local head = otherCharacter
                and otherCharacter:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and otherRoot and head then
                local distance = (otherRoot.Position - root.Position).Magnitude

                if distance < shortestDistance then
                    shortestDistance = distance
                    closestHead = head
                end
            end
        end
    end

    return closestHead
end

RunService:BindToRenderStep(
    "EclipseAimlock",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if not gui.Parent then
            RunService:UnbindFromRenderStep("EclipseAimlock")
            return
        end

        if not state.Aimlock then return end

        local camera = workspace.CurrentCamera
        local target = closestPlayerHead()

        if not camera or not target or not target.Parent then
            return
        end

        local direction = target.Position - camera.CFrame.Position
        if direction.Magnitude > 0.01 then
            local goal = CFrame.lookAt(
                camera.CFrame.Position,
                target.Position
            )

            camera.CFrame = camera.CFrame:Lerp(goal, 0.22)
        end
    end
)

