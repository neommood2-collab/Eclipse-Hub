local function updateESP(p)
    if not settings.ESP or not validESPPlayer(p) then
        clearESP(p)
        return
    end

    createESP(p)

    local data = espObjects[p]
    local character = p.Character
    local hum = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not data or not hum or not root then return end

    local cf,size = character:GetBoundingBox()
    local minX,minY = math.huge,math.huge
    local maxX,maxY = -math.huge,-math.huge
    local found = false

    for x=-1,1,2 do
        for y=-1,1,2 do
            for z=-1,1,2 do
                local world = cf:PointToWorldSpace(Vector3.new(
                    size.X*x/2,
                    size.Y*y/2,
                    size.Z*z/2
                ))

                local pos,onScreen = camera:WorldToViewportPoint(world)

                if onScreen and pos.Z > 0 then
                    found = true
                    minX = math.min(minX,pos.X)
                    minY = math.min(minY,pos.Y)
                    maxX = math.max(maxX,pos.X)
                    maxY = math.max(maxY,pos.Y)
                end
            end
        end
    end

    if not found then
        data.Box.Visible = false
        data.Info.Visible = false
        data.HealthBack.Visible = false
        hideLine(data.Tracer)

        for _,line in ipairs(data.Bones) do
            hideLine(line)
        end

        return
    end

    local width = maxX-minX
    local height = maxY-minY

    data.Box.Position = UDim2.fromOffset(minX,minY)
    data.Box.Size = UDim2.fromOffset(width,height)
    data.Box.Visible = settings.Box

    if settings.Tracer then
        local viewport = camera.ViewportSize

        drawLine(
            data.Tracer,
            Vector2.new(viewport.X/2,viewport.Y),
            Vector2.new((minX+maxX)/2,maxY)
        )
    else
        hideLine(data.Tracer)
    end

    local text = {}

    if settings.Name then
        table.insert(text,p.DisplayName)
    end

    if settings.Distance then
        local myRoot = player.Character
            and player.Character:FindFirstChild("HumanoidRootPart")

        if myRoot then
            table.insert(text,math.floor(
                (myRoot.Position-root.Position).Magnitude
            ).." studs")
        end
    end

    if settings.Health then
        table.insert(text,"HP "..math.floor(hum.Health))
    end

    data.Info.Text = table.concat(text," | ")
    data.Info.Position = UDim2.fromOffset((minX+maxX)/2,minY-3)
    data.Info.Visible = #text > 0

    if settings.Health then
        local ratio = math.clamp(
            hum.Health/math.max(hum.MaxHealth,1),
            0,
            1
        )

        data.HealthBack.Position = UDim2.fromOffset(minX-6,minY)
        data.HealthBack.Size = UDim2.fromOffset(4,height)
        data.HealthBack.Visible = true

        data.HealthFill.Size = UDim2.new(1,0,ratio,0)
        data.HealthFill.Position = UDim2.new(0,0,1-ratio,0)
        data.HealthFill.BackgroundColor3 =
            ratio > 0.5 and GREEN
            or ratio > 0.25 and Color3.fromRGB(255,190,50)
            or RED
    else
        data.HealthBack.Visible = false
    end

    for i,pair in ipairs(skeletonPairs) do
        local a = projectPart(character,pair[1])
        local b = projectPart(character,pair[2])

        if settings.Skeleton and a and b then
            drawLine(data.Bones[i],a,b)
        else
            hideLine(data.Bones[i])
        end
    end
end

