-- OBJETOS DE ESP
local function clearESP(targetPlayer)
    local oldObject = espObjects[targetPlayer]
    if oldObject then
        oldObject:Destroy()
        espObjects[targetPlayer] = nil
    end
end

local function createESP(targetPlayer)
    if espObjects[targetPlayer] then return end

    local character = targetPlayer.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not head or not root or not humanoid then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "EclipseESP"
    highlight.Adornee = character
    highlight.FillTransparency = 1
    highlight.OutlineColor = BLUE
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EclipseInfo"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(180,55)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = false
    billboard.Parent = gui

    local info = Instance.new("TextLabel")
    info.Size = UDim2.fromScale(1,1)
    info.BackgroundTransparency = 1
    info.TextColor3 = WHITE
    info.TextStrokeTransparency = 0
    info.Font = Enum.Font.GothamBold
    info.TextSize = 12
    info.Parent = billboard

    espObjects[targetPlayer] = Instance.new("Folder")
    highlight.Parent = espObjects[targetPlayer]
    billboard.Parent = espObjects[targetPlayer]
    espObjects[targetPlayer].Parent = gui
    espObjects[targetPlayer]:SetAttribute("Character", true)
end

-- VERIFICAR LINHA DE VISAO
local function visibleToCamera(character)
    local head = character:FindFirstChild("Head")
    if not head then return false end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        player.Character,
        character
    }

    local direction = head.Position - camera.CFrame.Position

    local result = workspace:Raycast(
        camera.CFrame.Position,
        direction,
        params
    )

    return result == nil
end

-- ATUALIZACAO
local function updateESP()
    camera = workspace.CurrentCamera
    if not camera then return end

    for _,targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local character = targetPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            local allowed = settings.ESP
                and character
                and root
                and humanoid
                and humanoid.Health > 0

            if allowed then
                local myRoot = player.Character
                    and player.Character:FindFirstChild("HumanoidRootPart")

                local distance = myRoot
                    and (myRoot.Position-root.Position).Magnitude
                    or math.huge

                local sameTeam = settings.TeamCheck
                    and targetPlayer.Team == player.Team

                local visible = visibleToCamera(character)

                allowed = distance <= settings.MaxDistance
                    and not sameTeam
                    and (not settings.WallCheck or visible)
            end

            if allowed then
                createESP(targetPlayer)

                local folder = espObjects[targetPlayer]
                local highlight = folder and folder:FindFirstChild("EclipseESP")
                local billboard = folder and folder:FindFirstChild("EclipseInfo")

                if highlight then
                    highlight.Enabled = settings.Box
                end

                if billboard then
                    local info = billboard:FindFirstChildOfClass("TextLabel")
                    local text = {}

                    if settings.Name then
                        table.insert(text,targetPlayer.DisplayName)
                    end

                    if settings.Distance then
                        local myRoot = player.Character
                            and player.Character:FindFirstChild("HumanoidRootPart")

                        if myRoot then
                            local d = (myRoot.Position-root.Position).Magnitude
                            table.insert(text,math.floor(d).." studs")
                        end
                    end

                    if settings.Health then
                        local h = character:FindFirstChildOfClass("Humanoid")
                        if h then
                            table.insert(text,"HP: "..math.floor(h.Health))
                        end
                    end

                    if info then
                        info.Text = table.concat(text," | ")
                    end
                end
            else
                clearESP(targetPlayer)
            end
        end
    end
end

