-- LOOP PRINCIPAL
--========================================================

local renderConnection

renderConnection = RunService.RenderStepped:Connect(function()
    camera = workspace.CurrentCamera
    if not camera then return end

    crosshair.Visible = settings.Crosshair
    fov.Visible = settings.FOV
    fov.Size = UDim2.fromOffset(settings.FOVSize,settings.FOVSize)

    -- ESP INDEPENDENTE DO AIMLOCK
    if settings.ESP then
        for _,p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                updateESP(p)
            end
        end
    else
        for p in pairs(espObjects) do
            clearESP(p)
        end
    end

    -- Aimlock seleciona o jogador fisicamente mais próximo
    if settings.Aimlock then
        local target = getClosestPlayer()

        if target and target.Character then
            local head = target.Character:FindFirstChild("Head")

            if head then
                local goal = CFrame.lookAt(
                    camera.CFrame.Position,
                    head.Position
                )

                camera.CFrame = camera.CFrame:Lerp(
                    goal,
                    settings.Smoothness
                )
            end
        end
    end
end)

