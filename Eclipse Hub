local function removeESP(otherPlayer)
    if highlights[otherPlayer] then
        highlights[otherPlayer]:Destroy()
        highlights[otherPlayer] = nil
    end
end

local function createESP(otherPlayer)
    removeESP(otherPlayer)

    if not state.ESP or otherPlayer == player then return end

    local character = otherPlayer.Character
    if not character then return end

    local h = Instance.new("Highlight")
    h.Name = "EclipseESP"
    h.Adornee = character
    h.FillColor = COLORS.red
    h.OutlineColor = COLORS.red
    h.FillTransparency = 0.65
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = gui

    highlights[otherPlayer] = h
end

local function refreshESP()
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            if state.ESP then
                createESP(otherPlayer)
            else
                removeESP(otherPlayer)
            end
        end
    end
end

table.insert(connections, Players.PlayerAdded:Connect(function(otherPlayer)
    otherPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if state.ESP then createESP(otherPlayer) end
    end)
end))

table.insert(connections, Players.PlayerRemoving:Connect(function(otherPlayer)
    removeESP(otherPlayer)
end))

for _, otherPlayer in ipairs(Players:GetPlayers()) do
    if otherPlayer ~= player then
        otherPlayer.CharacterAdded:Connect(function()
            task.wait(0.5)
            if state.ESP then createESP(otherPlayer) end
        end)
    end
end

