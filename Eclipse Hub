local function toggleButton(parent, name, key, callback)
    local b = actionButton(parent, name .. "  [OFF]", function() end)

    local function refresh()
        b.Text = name .. (state[key] and "  [ON]" or "  [OFF]")
        b.BackgroundColor3 = state[key] and COLORS.blue or COLORS.card
    end

    b.MouseButton1Click:Connect(function()
        state[key] = not state[key]
        if callback then callback(state[key]) end
        refresh()
    end)

    refresh()
    return b
end

