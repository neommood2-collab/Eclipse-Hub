
-- AIMLOCK AUTOMÁTICO
-- Todos os jogadores, sem verificar times

local function closestEnemy()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then return nil end

    local bestTarget = nil
    local bestDistance = math.huge

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local targetChar = plr.Character
            local hum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local head = targetChar and targetChar:FindFirstChild("Head")

            if hum and hum.Health > 0 and targetRoot and head then
                local distance = (targetRoot.Position - root.Position).Magnitude

                if distance < bestDistance then
                    bestDistance = distance
                    bestTarget = head
                end
            end
        end
    end

    return bestTarget
end

-- Mira automática para testes no próprio jogo
local aimConnection

aimConnection = RunService:BindToRenderStep(
    "EclipseAimlock",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if not gui.Parent then
            RunService:UnbindFromRenderStep("EclipseAimlock")
            return
        end

        if not state.Aimlock then return end

        local target = closestEnemy()
        local cam = workspace.CurrentCamera

        if not target or not cam then return end

        local direction = target.Position - cam.CFrame.Position

        if direction.Magnitude > 0 then
            cam.CFrame = CFrame.lookAt(
                cam.CFrame.Position,
                target.Position
            )
        end
    end
)
