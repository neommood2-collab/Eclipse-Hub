local function newLine(parent,color)
    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0.5,0.5)
    line.BackgroundColor3 = color or BLUE
    line.BorderSizePixel = 0
    line.Size = UDim2.fromOffset(0,2)
    line.Visible = false
    line.Parent = parent
    return line
end

local function drawLine(line,a,b)
    local delta = b-a
    line.Position = UDim2.fromOffset(
        (a.X+b.X)/2,
        (a.Y+b.Y)/2
    )
    line.Size = UDim2.fromOffset(delta.Magnitude,2)
    line.Rotation = math.deg(math.atan2(delta.Y,delta.X))
    line.Visible = true
end

local function hideLine(line)
    line.Visible = false
end

