local function makeLabel(parent,text,height,size,color)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1,-12,0,height or 30)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = color or WHITE
    l.Font = Enum.Font.GothamBold
    l.TextSize = size or 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

local function makeButton(parent,text,callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-12,0,36)
    b.BackgroundColor3 = Color3.fromRGB(39,46,64)
    b.TextColor3 = WHITE
    b.Text = text
    b.Font = Enum.Font.Gotham
    b.TextSize = 13
    b.Parent = parent
    round(b,7)
    b.Activated:Connect(callback)
    return b
end

local function makeToggle(parent,text,key,callback)
    local b

    local function refresh()
        b.Text = text..(settings[key] and "  [ON]" or "  [OFF]")
        b.BackgroundColor3 = settings[key]
            and Color3.fromRGB(0,85,150)
            or Color3.fromRGB(39,46,64)
    end

    b = makeButton(parent,text,function()
        settings[key] = not settings[key]
        refresh()
        if callback then callback(settings[key]) end
    end)

    refresh()
    return b
end

local function section(parent,text)
